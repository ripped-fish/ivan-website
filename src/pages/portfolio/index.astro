---
import '../../styles/global.css';
import { portfolioBrands } from '../../data/portfolio';

const finalBrandSlugs = new Set(['stormtech', 'hibear']);
const campaignBrands = [
  ...portfolioBrands.filter((brand) => !finalBrandSlugs.has(brand.slug)),
  ...portfolioBrands.filter((brand) => finalBrandSlugs.has(brand.slug)),
];

const title = 'Portfolio - Ivan Chan';
const description = 'Selected commercial, outdoor, and adventure photography campaigns by Ivan Chan.';
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://ivanpkchan.com/portfolio/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={campaignBrands[0].cardCover ?? campaignBrands[0].cover} />
  </head>
  <body class="portfolio-page">
    <div class="scroll-progress" aria-hidden="true"></div>
    <nav class="masking-nav commercial-nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">IVAN <span>Chan</span></a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
          <a href="/commercial/">Commercial</a>
          <a href="/course/">Course</a>
          {
            isDev && (
              <div class="dev-menu">
                <button type="button" class="dev-menu-toggle">Dev</button>
                <div class="dev-menu-list" role="menu" aria-label="Development pages">
                  <a href="/masking-guide/" role="menuitem">Masking Guide</a>
                  <a href="/newsletter/" role="menuitem">Newsletter</a>
                  <a href="/links/" role="menuitem">Links</a>
                  <a href="/commercial/" role="menuitem">Commercial</a>
                  <a href="/portfolio/" role="menuitem">Portfolio</a>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </nav>

    <main>
      <header class="portfolio-hero">
        <div class="wrap" data-reveal>
          <div class="eyebrow">Selected Work</div>
          <h1 class="display">Campaigns</h1>
          <p>Commercial stories created with outdoor brands in the places their products come alive.</p>
        </div>
      </header>

      <section class="portfolio-index" aria-label="Brand campaigns">
        <div class="wrap portfolio-card-grid" data-stagger>
          {
            campaignBrands.map((brand) => (
              <article class="portfolio-card">
                <a class="portfolio-card-media" href={`/portfolio/${brand.slug}/`} aria-label={`View the ${brand.name} campaign`}>
                  <img
                    src={brand.cardCover ?? brand.cover}
                    alt={`${brand.name} campaign by Ivan Chan`}
                    style={brand.cardCoverPosition ? `object-position:${brand.cardCoverPosition}` : undefined}
                    loading="lazy"
                  />
                  <span>View campaign <span aria-hidden="true">↗</span></span>
                </a>
                <div class="portfolio-card-copy">
                  <h2><a href={`/portfolio/${brand.slug}/`}>{brand.name}</a></h2>
                  <p>{brand.mediaType}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <script src="../../scripts/landing-page.js"></script>
    <script src="/funnel-analytics.js" is:inline></script>
  </body>
</html>
