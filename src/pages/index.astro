---
import '../styles/blog.css';

const title = 'Ivan Chan Photography';
const description =
  'Canadian travel and adventure photographer helping you create more visually impactful photos.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://ivanpkchan.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/home/ivan-portrait.jpg" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">IVAN <span>Chan</span></a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
          <a href="/course/">Course</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="home-hero">
        <img class="home-hero-bg" src="/assets/home/hero-original.jpg" alt="man standing on mountain peak" />
        <div class="home-hero-overlay" aria-hidden="true"></div>
        <div class="article-shell home-hero-grid">
          <div class="home-hero-copy">
            <h1>Helping You Create More <span>Visually Impactful</span> Photos</h1>
            <p>Landscape | Travel | Adventure</p>
          </div>
        </div>
      </section>

      <section class="home-about" data-reveal>
        <div class="article-shell about-grid">
          <div class="about-copy">
            <h2>Hey, I’m Ivan</h2>
            <p>
              I’m a Canadian travel and adventure photographer that’s explored <strong>40+ countries</strong>. I’ve
              spent thousands of hours in <strong>Lightroom &amp; Photoshop</strong> learning and refining techniques to
              make photos look however I desire and create <span class="marker">clean, visually impactful images.</span>
            </p>
            <p>
              <strong>
                I’m here to share all the knowledge and skills I’ve learned over the years to accelerate your progress
                as an editor and help you create the photos of your dreams.
              </strong>
            </p>
            <div class="social-row" aria-label="Social links">
              <a href="https://www.instagram.com/ivanpkhc/" target="_blank" rel="noopener">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.4" cy="6.6" r="1"></circle>
                </svg>
                Instagram
              </a>
              <a href="https://www.youtube.com/@ivanpkhchan" target="_blank" rel="noopener">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M3.8 7.7c.2-1.4 1.3-2.5 2.7-2.7 3.6-.4 7.4-.4 11 0 1.4.2 2.5 1.3 2.7 2.7.4 2.9.4 5.8 0 8.6-.2 1.4-1.3 2.5-2.7 2.7-3.6.4-7.4.4-11 0-1.4-.2-2.5-1.3-2.7-2.7-.4-2.8-.4-5.7 0-8.6z"></path>
                  <path d="m10 9 5 3-5 3z"></path>
                </svg>
                YouTube
              </a>
            </div>
          </div>
          <div class="home-hero-media">
            <img src="/assets/home/ivan-portrait.jpg" alt="" />
          </div>
        </div>
      </section>

      <section class="client-strip" aria-label="Trusted clients" data-reveal>
        <div class="article-shell">
          <div class="client-head">
            <h2>Trusted by these Amazing Clients</h2>
          </div>
          <div class="client-grid" data-stagger>
            <img src="/assets/home/brand-hero.png" alt="" />
            <img src="/assets/home/client-1.png" alt="Commercial photography sample" />
            <img src="/assets/home/client-sawyer.png" alt="Sawyer commercial photography sample" />
            <img src="/assets/home/client-gsi.png" alt="GSI commercial photography sample" />
            <img src="/assets/home/client-stormtech.png" alt="Stormtech commercial photography sample" />
            <img class="adobe-logo" src="/assets/home/adobe-logo.svg" alt="Adobe" />
          </div>
        </div>
      </section>

      <section class="home-gallery" data-reveal>
        <div class="article-shell editorial-gallery" data-stagger>
          <figure><img src="/assets/home/gallery-1.jpg" alt="Adventure photography scene" /></figure>
          <figure><img src="/assets/home/gallery-2.jpg" alt="Landscape photography scene" /></figure>
          <figure><img src="/assets/home/gallery-3.jpg" alt="Aerial landscape photography scene" /></figure>
          <figure><img src="/assets/home/gallery-4.jpg" alt="Travel photography scene" /></figure>
          <figure><img src="/assets/home/gallery-5.jpg" alt="Mountain travel photography scene" /></figure>
          <figure><img src="/assets/home/gallery-6.jpg" alt="Adventure photography scene" /></figure>
          <figure><img src="/assets/home/gallery-7.jpg" alt="Landscape photography scene" /></figure>
          <figure><img src="/assets/home/gallery-8.jpg" alt="Travel photography scene" /></figure>
        </div>
      </section>

      <section class="newsletter-section" data-reveal="scale">
        <div class="article-shell newsletter wide-newsletter">
          <div>
            <h2>Join my Newsletter</h2>
            <p>Get notified whenever I publish new tips, tricks, and techniques on this blog + exclusive resources.</p>
            <p>I respect your privacy. Unsubscribe at anytime.</p>
          </div>
          <form class="home-newsletter-form" action="https://app.kit.com/forms/8589543/subscriptions" method="post">
            <input name="fields[first_name]" placeholder="First Name" type="text" aria-label="First Name" required />
            <input name="email_address" placeholder="Email Address" type="email" aria-label="Email Address" required />
            <button type="submit">Subscribe</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-row">
        <span>© 2026 Ivan Chan Photography</span>
        <span>Landscape | Travel | Adventure</span>
      </div>
    </footer>
    <script src="../scripts/landing-page.js"></script>
  </body>
</html>
