---
import '../../styles/media-kit.css';

const title = 'Instagram Media Kit | Ivan Chan Photography';
const description = 'Live Instagram audience and performance statistics for Ivan Chan Photography.';

const collaborations = [
  {
    slug: 'adobe-lightroom',
    shortcode: 'DQW-nz-CYoO',
    brand: 'Adobe',
    title: 'Lightroom Feature Release',
    kind: 'reel',
    video: 'https://media.ivanpkchan.com/videos/adobe-lightroom-new-features.mp4',
    poster: '/assets/portfolio/adobe-video-poster.jpg',
    href: 'https://www.instagram.com/reel/DQW-nz-CYoO/',
  },
  {
    slug: 'adobe-firefly',
    shortcode: 'DcTwdXEm5-P',
    brand: 'Adobe',
    title: 'Firefly Boards Carousel',
    kind: 'carousel',
    href: 'https://www.instagram.com/p/DcTwdXEm5-P/?img_index=1',
    slides: [
      { type: 'image', src: '/assets/media-kit/collaborations/firefly/01.jpg' },
      { type: 'image', src: '/assets/media-kit/collaborations/firefly/02.jpg' },
      { type: 'video', src: 'https://media.ivanpkchan.com/collaborations/adobe-firefly-boards/03.mp4', poster: '/assets/media-kit/collaborations/firefly/03-poster.jpg' },
      { type: 'video', src: 'https://media.ivanpkchan.com/collaborations/adobe-firefly-boards/04.mp4', poster: '/assets/media-kit/collaborations/firefly/04-poster.jpg' },
      { type: 'video', src: 'https://media.ivanpkchan.com/collaborations/adobe-firefly-boards/05.mp4', poster: '/assets/media-kit/collaborations/firefly/05-poster.jpg' },
      { type: 'image', src: '/assets/media-kit/collaborations/firefly/06.jpg' },
      { type: 'video', src: 'https://media.ivanpkchan.com/collaborations/adobe-firefly-boards/07.mp4', poster: '/assets/media-kit/collaborations/firefly/07-poster.jpg' },
      { type: 'video', src: 'https://media.ivanpkchan.com/collaborations/adobe-firefly-boards/08.mp4', poster: '/assets/media-kit/collaborations/firefly/08-poster.jpg' },
      { type: 'image', src: '/assets/media-kit/collaborations/firefly/09.jpg' },
      { type: 'image', src: '/assets/media-kit/collaborations/firefly/10.jpg' },
    ],
  },
  {
    slug: 'promaster',
    shortcode: '',
    brand: 'Promaster',
    title: 'Chronicle Tripod',
    kind: 'reel',
    video: 'https://media.ivanpkchan.com/videos/promaster-chronicle-tripod.mp4',
    poster: '/assets/portfolio/promaster-chronicle-video-poster.jpg',
  },
  {
    slug: 'sawyer',
    shortcode: '',
    brand: 'Sawyer',
    title: 'Sawyer Squeeze',
    kind: 'reel',
    video: 'https://media.ivanpkchan.com/videos/sawyer.mp4',
    poster: '/assets/portfolio/sawyer-video-poster.jpg',
  },
  {
    slug: 'tamron-17-28',
    shortcode: 'DHqyIOTxAzH',
    brand: 'Tamron',
    title: '17-28mm F2.8 Di III Lens',
    kind: 'reel',
    video: 'https://media.ivanpkchan.com/videos/tamron-17-28mm-astro.mp4',
    poster: '/assets/portfolio/tamron-17-28mm-astro-video-poster.jpg',
    href: 'https://www.instagram.com/reel/DHqyIOTxAzH/',
  },
  {
    slug: 'tamron-35-100',
    shortcode: 'DXrfmjfBpjn',
    brand: 'Tamron',
    title: '35-100mm F2.8 Di III Lens',
    kind: 'reel',
    video: 'https://media.ivanpkchan.com/videos/tamron-35-100mm.mp4',
    poster: '/assets/portfolio/tamron-35-100mm-video-poster.jpg',
    href: 'https://www.instagram.com/reel/DXrfmjfBpjn/',
  },
  {
    slug: 'tamron-90',
    shortcode: 'DNYaQnVRwDZ',
    brand: 'Tamron',
    title: '90mm F2.8 Di III Lens',
    kind: 'reel',
    video: 'https://media.ivanpkchan.com/videos/tamron-90mm.mp4',
    poster: '/assets/portfolio/tamron-90mm-video-poster.jpg',
    href: 'https://www.instagram.com/reel/DNYaQnVRwDZ/',
  },
  {
    slug: 'tamron-90-2',
    shortcode: 'DNBPu3hx6IV',
    brand: 'Tamron',
    title: '90mm F2.8 Di III Lens - 2',
    kind: 'reel',
    video: 'https://media.ivanpkchan.com/videos/tamron-90mm-2.mp4',
    poster: '/assets/portfolio/tamron-90mm-2-video-poster.jpg',
    href: 'https://www.instagram.com/reel/DNBPu3hx6IV/',
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://ivanpkchan.com/media-kit/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://ivanpkchan.com/assets/media-kit/ivan-headshot.jpg" />
  </head>
  <body class="media-kit-page">
    <main class="media-sheet">
      <header class="media-topbar">
        <a class="brand" href="/">IVAN <span>Chan</span></a>
        <span class="live-pill"><span aria-hidden="true"></span>Live data</span>
      </header>

      <section class="profile-block">
        <div class="profile-copy">
          <div class="eyebrow">Instagram media kit · 2026</div>
          <h1>Ivan Chan</h1>
          <p class="profile-tags">Travel &amp; Adventure Photographer</p>
          <div class="about-copy">
            <p>Travel and adventure lover seeking to capture the spirit of adventure through photography, to showcase the world’s most extreme and exotic landscapes, and teach people how to edit photos better.</p>
          </div>
          <div class="profile-meta">
            <a data-field="profileLink" href="https://www.instagram.com/ivanpkhc/" target="_blank" rel="noopener noreferrer">@ivanpkhc</a>
            <div class="follower-block">
              <div class="follower-count">
                <strong data-field="followers" data-loading>—</strong>
                <span>followers</span>
              </div>
              <a class="email-button email-button-small" href="mailto:partnerships@ivanpkchan.com">partnerships@ivanpkchan.com</a>
            </div>
          </div>
        </div>
        <figure class="profile-photo">
          <img src="/assets/media-kit/ivan-headshot.jpg" alt="Portrait of Ivan Chan" />
        </figure>
      </section>

      <section class="insights-band" aria-labelledby="insights-heading">
        <div class="stats-panel">
          <div class="panel-head">
            <div class="panel-title">
              <h2 id="insights-heading">Instagram Statistics</h2>
              <span class="live-pill"><span aria-hidden="true"></span>Live data</span>
            </div>
            <div class="period-toggle" aria-label="Reporting period">
              <button type="button" data-period="30" aria-pressed="true">30 days</button>
              <button type="button" data-period="90" aria-pressed="false">90 days</button>
            </div>
          </div>

          <div class="stats-grid">
            <article class="stat-card">
              <div class="stat-name">Total reach <button class="info-tip" type="button" aria-label="How total reach is calculated" data-tooltip="Sum of post-level reach for measurable posts published in the selected period.">?</button></div>
              <strong data-metric="reach" data-loading>—</strong>
            </article>
            <article class="stat-card">
              <div class="stat-name">Average reach <button class="info-tip" type="button" aria-label="How average reach is calculated" data-tooltip="Total measurable post reach divided by posts with available reach data in the selected period.">?</button></div>
              <strong data-metric="averagePostReach" data-loading>—</strong>
            </article>
            <article class="stat-card">
              <div class="stat-name">Average likes <button class="info-tip" type="button" aria-label="How average likes is calculated" data-tooltip="Total likes divided by posts published in the selected period.">?</button></div>
              <strong data-metric="averageLikes" data-loading>—</strong>
            </article>
            <article class="stat-card">
              <div class="stat-name">Average saves <button class="info-tip" type="button" aria-label="How average saves is calculated" data-tooltip="Total saves divided by posts with available Instagram Insights.">?</button></div>
              <strong data-metric="averageSaves" data-loading>—</strong>
            </article>
            <article class="stat-card">
              <div class="stat-name">Average shares <button class="info-tip" type="button" aria-label="How average shares is calculated" data-tooltip="Total shares divided by posts with available Instagram Insights.">?</button></div>
              <strong data-metric="averageShares" data-loading>—</strong>
            </article>
            <article class="stat-card">
              <div class="stat-name">Average impressions <button class="info-tip" type="button" aria-label="How average impressions is calculated" data-tooltip="Average Instagram views/impressions per measurable post. Meta now reports this post-level metric as views.">?</button></div>
              <strong data-metric="averageImpressions" data-loading>—</strong>
            </article>
            <article class="stat-card stat-card-accent">
              <div class="stat-name">Engagement rate <button class="info-tip" type="button" aria-label="How engagement rate is calculated" data-tooltip="Likes, comments, saves and shares divided by measurable post reach.">?</button></div>
              <strong data-metric="engagementRate" data-loading>—</strong>
            </article>
          </div>
        </div>

        <aside class="audience-panel" aria-labelledby="audience-heading">
          <div class="panel-head audience-head">
            <div class="panel-title">
              <h2 id="audience-heading">Audience</h2>
              <span class="live-pill live-pill-dark"><span aria-hidden="true"></span>Live data</span>
            </div>
            <button class="info-tip info-tip-light" type="button" aria-label="How audience demographics are calculated" data-tooltip="Follower demographics supplied by Instagram. Percentages use followers whose country or gender was available to Meta.">?</button>
          </div>
          <div class="audience-groups">
            <section>
              <h3>Gender</h3>
              <div class="audience-list" data-audience="gender"><span class="audience-loading">Loading…</span></div>
            </section>
            <section>
              <h3>Top countries</h3>
              <div class="audience-list" data-audience="countries"><span class="audience-loading">Loading…</span></div>
            </section>
          </div>
        </aside>
      </section>

      <section class="collaborations-block" aria-labelledby="collaborations-heading">
        <div class="collaborations-head">
          <div>
            <span class="eyebrow">Selected brand work</span>
            <h2 id="collaborations-heading">Featured Collaborations</h2>
          </div>
          <p>Reels and campaign carousels created for photography, travel, and outdoor brands.</p>
        </div>

        <div class="collaborations-grid">
          {
            collaborations.map((collaboration) => (
              <article class="collaboration-card" data-collaboration-card data-collaboration-slug={collaboration.slug} data-instagram-shortcode={collaboration.shortcode || undefined}>
                {collaboration.kind === 'carousel' ? (
                  <div class="collaboration-media collaboration-carousel" data-collaboration-carousel>
                    <div class="collaboration-slides">
                      {collaboration.slides.map((slide, index) => (
                        <div class="collaboration-slide" data-carousel-slide hidden={index !== 0} aria-hidden={index !== 0 ? 'true' : 'false'}>
                          {slide.type === 'image' ? (
                            <img
                              src={slide.src}
                              alt={`${collaboration.brand} ${collaboration.title}, slide ${index + 1}`}
                              loading={index === 0 ? 'eager' : 'lazy'}
                            />
                          ) : (
                            <video
                              src={slide.src}
                              poster={slide.poster}
                              aria-label={`${collaboration.brand} ${collaboration.title}, video slide ${index + 1}`}
                              preload="none"
                              controls
                              playsinline
                              data-collaboration-video
                            />
                          )}
                        </div>
                      ))}
                    </div>
                    <div class="carousel-controls">
                      <button type="button" data-carousel-previous aria-label={`Previous slide in ${collaboration.title}`}>←</button>
                      <span><strong data-carousel-current>1</strong> / {collaboration.slides.length}</span>
                      <button type="button" data-carousel-next aria-label={`Next slide in ${collaboration.title}`}>→</button>
                    </div>
                  </div>
                ) : (
                  <div class="collaboration-media">
                    <video
                      src={collaboration.video}
                      poster={collaboration.poster}
                      aria-label={`${collaboration.brand}: ${collaboration.title}`}
                      preload="none"
                      controls
                      playsinline
                      data-collaboration-video
                    />
                  </div>
                )}
                <div class="collaboration-copy">
                  <div class="collaboration-meta">
                    <span>{collaboration.brand}</span>
                    <span>{collaboration.kind}</span>
                  </div>
                  <h3>{collaboration.title}</h3>
                  {
                    collaboration.shortcode && (
                      <div class="collaboration-insights" data-collaboration-insights aria-label="Instagram post performance">
                        <span data-insight-loading>Loading live insights…</span>
                      </div>
                    )
                  }
                  {
                    collaboration.href && (
                      <a href={collaboration.href} target="_blank" rel="noopener noreferrer">
                        View on Instagram <span aria-hidden="true">↗</span>
                      </a>
                    )
                  }
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="client-strip" aria-label="Trusted clients">
        <div class="article-shell">
          <div class="client-head">
            <h2>Trusted by these Amazing Clients</h2>
          </div>
          <div class="client-grid">
            <img src="/assets/home/brand-hero.png" alt="" />
            <img src="/assets/home/client-1.png" alt="Commercial photography sample" />
            <img src="/assets/home/client-sawyer.png" alt="Sawyer commercial photography sample" />
            <img src="/assets/home/client-gsi.png" alt="GSI commercial photography sample" />
            <img src="/assets/home/client-stormtech.png" alt="Stormtech commercial photography sample" />
            <img class="adobe-logo" src="/assets/home/adobe-logo.svg" alt="Adobe" />
          </div>
        </div>
      </section>

      <section class="contact-block">
        <div>
          <span class="eyebrow">Partnerships &amp; collaborations</span>
          <h2>Let’s make something worth remembering.</h2>
        </div>
        <a class="email-button" href="mailto:partnerships@ivanpkchan.com">partnerships@ivanpkchan.com</a>
      </section>

      <footer class="media-footer">
        <span data-field="updatedAt">Loading latest Instagram snapshot…</span>
        <span>© 2026 Ivan Chan Photography</span>
      </footer>
      <p class="media-kit-error" data-error role="status">Live figures are temporarily unavailable. Please try again shortly.</p>
    </main>

    <script>
      const endpoint = 'https://dashboard.ivanpkchan.com/api/public/media-kit/instagram';
      const compactNumber = new Intl.NumberFormat('en-CA', { notation: 'compact', maximumFractionDigits: 1 });
      const percentage = new Intl.NumberFormat('en-CA', { maximumFractionDigits: 1 });
      const regionNames = new Intl.DisplayNames(['en'], { type: 'region' });
      const genderLabels = { M: 'Men', F: 'Women', U: 'Unspecified' };
      let mediaKitData;
      let activePeriod = '30';

      const setField = (name, value) => {
        const element = document.querySelector(`[data-field="${name}"]`);
        if (!element) return;
        element.textContent = value;
        element.removeAttribute('data-loading');
      };

      const formatMetric = (value) => compactNumber.format(Number(value) || 0);

      const renderWindow = () => {
        if (!mediaKitData) return;
        const windowData = activePeriod === '30' ? mediaKitData.windows.thirtyDays : mediaKitData.windows.ninetyDays;
        document.querySelectorAll('[data-metric]').forEach((element) => {
          const key = element.getAttribute('data-metric');
          if (!key) return;
          const rawValue = windowData[key];
          element.textContent = key === 'engagementRate' ? `${percentage.format(rawValue)}%` : formatMetric(rawValue);
          element.removeAttribute('data-loading');
        });
      };

      const renderAudience = (selector, rows, labelFor) => {
        const container = document.querySelector(`[data-audience="${selector}"]`);
        if (!container) return;
        container.replaceChildren(...rows.map((row) => {
          const item = document.createElement('div');
          const label = document.createElement('span');
          const value = document.createElement('strong');
          label.textContent = labelFor(row.key);
          value.textContent = `${percentage.format(row.percentage)}%`;
          item.append(label, value);
          return item;
        }));
      };

      const renderCollaborations = (collaborations = []) => {
        const insightsByShortcode = new Map(collaborations.map((item) => [item.shortcode, item]));
        const grid = document.querySelector('.collaborations-grid');
        if (!grid) return;

        const cards = [...grid.querySelectorAll('[data-collaboration-card]')];
        cards.forEach((card) => {
          const shortcode = card.getAttribute('data-instagram-shortcode');
          if (!shortcode) return;
          const insight = insightsByShortcode.get(shortcode);
          const container = card.querySelector('[data-collaboration-insights]');
          if (!container) return;

          if (!insight) {
            container.textContent = 'Insights unavailable';
            container.classList.add('is-unavailable');
            return;
          }

          const metrics = [
            ['Reach', formatMetric(insight.reach)],
            ['Views', formatMetric(insight.views)],
            ['Engagement', `${percentage.format(insight.engagementRate)}%`],
          ];
          container.replaceChildren(...metrics.map(([labelText, valueText]) => {
            const metric = document.createElement('span');
            const value = document.createElement('strong');
            const label = document.createElement('small');
            value.textContent = valueText;
            label.textContent = labelText;
            metric.append(value, label);
            return metric;
          }));
        });

        const ranked = cards
          .filter((card) => card.hasAttribute('data-instagram-shortcode'))
          .sort((left, right) => {
            const leftInsight = insightsByShortcode.get(left.getAttribute('data-instagram-shortcode'));
            const rightInsight = insightsByShortcode.get(right.getAttribute('data-instagram-shortcode'));
            return (rightInsight?.reach || 0) - (leftInsight?.reach || 0);
          });
        const promaster = cards.find((card) => card.getAttribute('data-collaboration-slug') === 'promaster');
        const sawyer = cards.find((card) => card.getAttribute('data-collaboration-slug') === 'sawyer');
        const ordered = [
          ...ranked.slice(0, 2),
          promaster,
          ...ranked.slice(2, 4),
          sawyer,
          ...ranked.slice(4),
        ].filter(Boolean);
        grid.append(...ordered);
      };

      document.querySelectorAll('[data-period]').forEach((button) => {
        button.addEventListener('click', () => {
          activePeriod = button.getAttribute('data-period') || '30';
          document.querySelectorAll('[data-period]').forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
          renderWindow();
        });
      });

      const collaborationVideos = document.querySelectorAll('[data-collaboration-video]');
      collaborationVideos.forEach((video) => {
        if (!(video instanceof HTMLVideoElement)) return;
        video.addEventListener('play', () => {
          collaborationVideos.forEach((otherVideo) => {
            if (otherVideo instanceof HTMLVideoElement && otherVideo !== video && !otherVideo.paused) otherVideo.pause();
          });
        });
      });

      document.querySelectorAll('[data-collaboration-carousel]').forEach((carousel) => {
        const slides = [...carousel.querySelectorAll('[data-carousel-slide]')];
        const current = carousel.querySelector('[data-carousel-current]');
        const previous = carousel.querySelector('[data-carousel-previous]');
        const next = carousel.querySelector('[data-carousel-next]');
        let activeIndex = 0;

        const showSlide = (index) => {
          activeIndex = (index + slides.length) % slides.length;
          slides.forEach((slide, slideIndex) => {
            const isActive = slideIndex === activeIndex;
            slide.toggleAttribute('hidden', !isActive);
            slide.setAttribute('aria-hidden', String(!isActive));
            if (!isActive) slide.querySelector('video')?.pause();
          });
          if (current) current.textContent = String(activeIndex + 1);
        };

        previous?.addEventListener('click', () => showSlide(activeIndex - 1));
        next?.addEventListener('click', () => showSlide(activeIndex + 1));
      });

      async function loadMediaKit() {
        try {
          const response = await fetch(endpoint, { headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error(`Media kit request failed with ${response.status}`);
          const payload = await response.json();
          if (!payload.ok) throw new Error('Media kit response was not successful');

          mediaKitData = payload.data;
          const { profile, audience, collaborations, generatedAt } = mediaKitData;
          setField('followers', formatMetric(profile.followers));
          renderWindow();
          renderAudience('gender', audience.gender, (key) => genderLabels[key] || key);
          renderAudience('countries', audience.countries, (key) => regionNames.of(key) || key);
          renderCollaborations(collaborations);

          const profileLink = document.querySelector('[data-field="profileLink"]');
          if (profileLink instanceof HTMLAnchorElement) {
            profileLink.href = profile.profileUrl;
            profileLink.textContent = `@${profile.username}`;
          }

          const updated = new Intl.DateTimeFormat('en-CA', {
            dateStyle: 'medium',
            timeStyle: 'short',
            timeZone: 'America/Vancouver',
          }).format(new Date(generatedAt));
          setField('updatedAt', `${payload.stale ? 'Last available snapshot' : 'Live Instagram data updated'} ${updated} PT`);
        } catch (error) {
          console.error(error);
          document.querySelector('[data-error]')?.classList.add('is-visible');
          setField('updatedAt', 'Live data temporarily unavailable');
        }
      }

      loadMediaKit();
    </script>
  </body>
</html>
